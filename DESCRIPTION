Package: ElNino
Title: Lee, Resume y Grafica Datos Meteorológicos
Version: 0.0.0.9000
Authors@R: c(
    person("Lucas", "Bruno", , "lucasmateobruno2@gmail.com", role = c("aut", "cre")),
    person("Valentino", "Ricci", role = "aut"),
    person("Lucas", "Boveri", role = "aut")
